{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "CommonJS",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./",
    "baseUrl": ".",
    "paths": {
      "@hindustan/shared/*": ["./*"]
    }
  },
  "include": [
    "types/**/*",
    "lib/**/*",
    "services/**/*",
    "components/**/*",
    "hooks/**/*",
    "utils/**/*",
    "schemas/**/*",
    "index.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
