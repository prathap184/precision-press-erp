# Tally Connector Service — Environment Configuration
# ─────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── ERP Cloud URL ──────────────────────────────────────────────────────────────
# The URL of your Next.js ERP (production or local dev URL)
ERP_BASE_URL=https://your-erp.vercel.app

# ── Connector Secret ────────────────────────────────────────────────────────────
# Must match TALLY_CONNECTOR_SECRET in your Next.js .env.local
CONNECTOR_SECRET=your-very-strong-secret-key-here

# ── TallyPrime Configuration ───────────────────────────────────────────────────
# TallyPrime must be running on THIS machine with HTTP server enabled
TALLY_HOST=http://localhost
TALLY_PORT=9000

# ── Polling Configuration ──────────────────────────────────────────────────────
# How often the connector checks the ERP queue (in milliseconds)
POLL_INTERVAL_MS=8000

# ── Logging ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FILE=./logs/connector.log

# ── Tally License Mode ────────────────────────────────────────────────────────
# Set to true if using Tally Educational (trial) copy.
# Educational Mode only allows voucher dates on the 1st, 2nd, and 31st of the month.
# Any other date causes a misleading "Voucher date is missing" error.
# Set to false on a fully licensed TallyPrime to use real transaction dates.
TALLY_EDUCATIONAL_MODE=true
